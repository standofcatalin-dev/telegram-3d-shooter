# Получи токен от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# URL где размещена твоя игра (фронтенд)
# Примеры:
# https://3d-platformer.vercel.app
# https://telegram-3d-shooter.netlify.app
# http://localhost:8000 (для локального тестирования)
WEB_APP_URL=https://your-domain.com

# Порт для Express сервера
PORT=3000
